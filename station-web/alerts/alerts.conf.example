# Ground Station alerts config. Installed to /etc/ground-station/alerts.conf
# (root, mode 600) only if that file doesn't exist yet. Every value shown is
# the built-in default, so a missing key or a missing file changes nothing.
# Restart after editing:  sudo systemctl restart station-alerts

[engine]
poll_seconds = 8
# one alert per aircraft per kind per this many hours
dedupe_hours = 4
# how many / how old public alerts the home page keeps
public_max = 30
public_hours = 48
max_seen_s = 15
# military / rare wait up to wait_for_position_s for a fresh position (seen
# within fresh_position_s) so the text can say where and the map can follow;
# then they go out marked "no position yet". Emergencies never wait.
wait_kinds = military,rare
wait_for_position_s = 300
fresh_position_s = 30
# "near <town>" uses the nearest built-in Front Range place within this (nmi)
place_radius_nm = 30

[emergency]
enabled = yes
squawks = 7500,7600,7700
# readsb `emergency` values that don't alert (lifeguard = air ambulance)
ignore = none,reserved,lifeguard
# polls in a row before alerting, filters one-off garbled squawks
confirm_polls = 2

[military]
enabled = yes

[rare]
enabled = yes
# alert when this many airframes of the type exist, or fewer. One alert per
# TYPE per dedupe_hours. 25 skips the 767-400 (38) that Denver sees daily.
max_worldwide = 25

[high]
enabled = yes
min_alt_ft = 50000

[low_home]
# PRIVATE: uses /etc/ground-station/location.env, log only, never served
enabled = yes
radius_nm = 2
max_agl_ft = 2000
# blank = height from location.env, else 5400 ft
field_elev_ft =

[lookup]
# PRIVATE: "go outside and look up" for interesting aircraft about to pass
# close and low in daylight. Phone only, never on the public page.
enabled = yes
radius_nm = 5
max_agl_ft = 10000
# sun at or above this = daylight (-6 = civil twilight)
sun_min_deg = -6
max_lead_min = 10
overhead_nm = 0.5
dedupe_hours = 2
# ICAO type designators; trailing * = family
heavy_types = B74*,B77*,A38*,A124,A225,AN22,C17,C5,C5M,KC46,K46,K35*,C135,R135,E3*,E6,E4,B52,B1,B2,C130,C30J,L100,A400
military = yes
rare = yes
helicopters = yes

[gps]
enabled = yes
window_s = 300
nacp_min = 8
nic_min = 7
min_tracked = 6
min_degraded = 3
min_share = 0.25
clear_after_s = 600
cooldown_hours = 2
region = Denver area

[notify]
# none | log | ntfy | pushover | email. Built-in default is none (nothing is
# sent). install.sh switches the Pi's copy to ntfy with the local server.
notifier = none
# high is left out on purpose (Anthony: not useful on the phone)
kinds = emergency,military,rare,low_home,gps,lookup
# global cap per rolling hour (on top of one per aircraft per kind per
# dedupe_hours); kinds in cap_exempt always go through
max_per_hour = 6
cap_exempt = emergency
ntfy_url = http://127.0.0.1:2586
ntfy_topic =
ntfy_token =
# tap a notification to open the public map following that aircraft:
# https://<host>/map (setup-ntfy.sh fills this on the Pi; keep the host out of git)
map_url =
map_zoom = 11
# pushover / email need outside network: add a drop-in that widens
# IPAddressAllow in station-alerts.service first
pushover_token =
pushover_user =
smtp_host =
smtp_port = 587
smtp_user =
smtp_password =
email_from =
email_to =
