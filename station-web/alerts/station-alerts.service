[Unit]
Description=Ground Station alert engine + GPS-interference monitor
After=readsb.service station-stats.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/station-web/station-alerts.py
Restart=always
RestartSec=30
# /run/station-web is shared with station-stats; keep it when either stops.
RuntimeDirectory=station-web
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# Private log + state. 0700: never served, root only.
StateDirectory=ground-station
StateDirectoryMode=0700
Nice=15
IOSchedulingClass=idle
CPUQuota=20%
MemoryMax=100M
ProtectSystem=strict
ReadWritePaths=/run/station-web /var/lib/ground-station
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# Sockets to localhost only: enough for the ntfy server on this Pi, nothing
# else. Pushover or email would need a drop-in (systemctl edit station-alerts)
# that widens IPAddressAllow.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
